        },
        {
          "name": "Create Admission (Stored Procedure)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": 1,\n  \"doctor_id\": 1,\n  \"bed_type\": \"normal\",\n  \"priority\": 3,\n  \"diagnosis\": \"Test admission\",\n  \"notes\": \"For testing\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admissions",
              "host": ["{{baseUrl}}"],
              "path": ["admissions"]
            },
            "description": "Demonstrates: Stored procedure call, automatic bed allocation, waiting list"
          }
        },
        {
          "name": "Create Manual Admission (Transaction)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": 2,\n  \"bed_id\": 5,\n  \"doctor_id\": 2,\n  \"priority\": 2,\n  \"diagnosis\": \"Manual admission test\",\n  \"notes\": \"Testing transaction\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admissions/manual",
              "host": ["{{baseUrl}}"],
              "path": ["admissions", "manual"]
            },
            "description": "Demonstrates: Transaction with row-level locking (SELECT FOR UPDATE)"
          }
        },
        {
          "name": "Discharge Patient",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admissions/1/discharge",
              "host": ["{{baseUrl}}"],
              "path": ["admissions", "1", "discharge"]
            },
            "description": "Demonstrates: Stored procedure, trigger-based bed status update"
          }
        }
      ]
    },
