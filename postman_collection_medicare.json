{
  "info": {
    "name": "Medicare API",
    "_postman_id": "medicare-hospital-api",
    "description": "Complete API collection for Medicare Hospital Management System - demonstrating DBMS concepts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('token', response.data.token);",
                  "    console.log('Token saved:', response.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login with username and password. Default credentials: admin/admin123"
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"password123\",\n  \"role\": \"staff\",\n  \"email\": \"newuser@medicare.com\",\n  \"full_name\": \"New User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "Get All Patients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["patients"],
              "query": [
                {"key": "limit", "value": "50"},
                {"key": "offset", "value": "0"},
                {"key": "search", "value": "John", "disabled": true}
              ]
            }
          }
        },
        {
          "name": "Get Patient by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients/1",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "1"]
            }
          }
        },
        {
          "name": "Get Patient History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients/1/history",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "1", "history"]
            },
            "description": "Demonstrates: Using views for complex queries"
          }
        },
        {
          "name": "Create Patient",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Test Patient\",\n  \"dob\": \"1990-01-01\",\n  \"gender\": \"M\",\n  \"phone\": \"555-9999\",\n  \"address\": \"123 Test St\",\n  \"emergency_contact\": \"555-8888\",\n  \"blood_group\": \"O+\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/patients",
              "host": ["{{baseUrl}}"],
              "path": ["patients"]
            },
            "description": "Demonstrates: Parameterized INSERT, constraints validation"
          }
        },
        {
          "name": "Update Patient",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"555-0000\",\n  \"address\": \"456 Updated St\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/patients/1",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Admissions",
